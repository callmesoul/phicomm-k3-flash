#!/bin/sh /etc/rc.common
# Xray proxy service for OpenWrt (installed at /etc/init.d/xray)

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/xray
CONF=/etc/xray/config.json
ASSET=/usr/share/xray

start_service() {
	[ -x "$PROG" ] || { echo "missing $PROG"; exit 1; }
	procd_open_instance xray
	procd_set_param command "$PROG" run -config "$CONF"
	procd_set_param env XRAY_LOCATION_ASSET="$ASSET"
	procd_set_param respawn 3600 5 5
	procd_set_param limits core="unlimited"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	service_stop "$PROG"
}
